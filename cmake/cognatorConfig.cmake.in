@PACKAGE_INIT@

# No find_dependency(merkmal). The pinned merkmal core is compiled into
# libcognator rather than linked against an installed one -- see
# third_party/merkmal -- so a consumer needs nothing else on the system.
#
# Building against an external merkmal instead (COGNATOR_MERKMAL_SOURCE_DIR)
# does produce a libcognator that depends on it, and that build is for
# recalibration and for packagers, who are configuring the dependency anyway.
@COGNATOR_CONFIG_MERKMAL_DEPENDENCY@
include("${CMAKE_CURRENT_LIST_DIR}/cognatorTargets.cmake")
check_required_components(cognator)
